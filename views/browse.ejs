<%- include ("partials/header")%>
<link rel="stylesheet" href="/css/browse.css">

  </head>
  <body>
    <%- include ("partials/navbar")%> 

    
 <% if (success && success.length > 0) { %>
    <div class="flash flash-success">
        <%= success %>
    </div>
<% } %>

<% if (error && error.length > 0) { %>
    <div class="flash flash-error">
        <%= error %>
    </div>
<% } %>


<div class="container">

    <div class="top-bar">
 <i data-lucide="search"></i>
        <input
            type="text"
            placeholder="Search by item name..."
        >

        <button>Search</button>

    </div>

<!-- 
    <div class="filters">

        <button class="active">All</button>

        <button>Lost</button>

        <button>Found</button>

    </div> -->


    <div class="items-grid">

    <% items.forEach(item => { %>

        <div class="card">

            <img
                src="/uploads/<%= item.image %>"
                alt="item image"
            >

            <div class="content">

                <div class="badge <%= item.status.toLowerCase() %>">
                    <%= item.status %>
                </div>

                <h2><%= item.itemName %></h2>

                <p class="category">
                    <%= item.category %>
                </p>

                <div class="info">
                    <p>📍 <%= item.loc %></p>
                    <p>📅 <%= item.date %></p>
                </div>

                <p class="description">
    <%= item.des.substring(0,100) %>...
</p>



    <% if (item.owner && item.owner.toString() === session.userId.toString()) { %>
<div class="card-actions">
    <a href="/items/<%= item._id %>/edit" class="edit-btn">
        Edit
    </a>

    <form action="/items/<%= item._id %>?_method=DELETE"
          method="POST"
          onsubmit="return confirm('Are you sure you want to delete this item?');">

        <button type="submit" class="delete-btn">
            Delete
        </button>

    </form>

</div>
<% } %>
            </div>

        </div>

    <% }) %>

</div>
</div>
    </div>

</div>

<%- include ("partials/footer")%>
  </body>
   <script>
    lucide.createIcons();
  
    setTimeout(() => {
        const alert = document.querySelector(".flash");
        if (alert) {
            alert.style.display = "none";
        }
    }, 3000);
  </script>
  </html>