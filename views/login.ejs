<!DOCTYPE html><html><head><link rel="stylesheet" href="/css/auth.css"></head><body><div class="container"><div class="card"><div class="left"><h1>Login</h1>
  
  
  <% if (success && success.length > 0) { %>
    <div class=" report flash-success">
        <%= success %>
    </div>
<% } %>

<% if (error && error.length > 0) { %>
    <div class=" report flash-error">
        <%= error %>
    </div>
<% } %><form action="/login" method="post"><input type="email" placeholder="Email" name="email"><input type="password" name="pass" placeholder="Password"><button type="submit">Login</button></form><p>Don't have an account? <a href="/signup">Sign Up</a></p></div><div class="right l" style="margin-top: 27px; height: 290px; margin-right: 29px;"></div></div></div>

<script>
    setTimeout(() => {
        const alert = document.querySelector(".report");
        if (alert) {
            alert.style.display = "none";
        }
    }, 3000);
</script>
</body></html>

